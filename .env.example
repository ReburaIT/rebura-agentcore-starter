# Copy this file to .env:   cp .env.example .env
# .env is git-ignored. Never commit it, and never put AWS keys in it.

# AWS region for Bedrock and AgentCore (default shown). Change it if the workshop organisers say so, or to the region you want to use.
# AGENTCORE_REGION=eu-central-1

# AgentCore Memory ID, needed for Memory mode and optional for the starter agent.
# Create one with:  python scripts/create_memory.py --write-env
# AGENTCORE_MEMORY_ID=

# Default model for the starter agent, demo.py and server.py. Use an inference profile ID that matches your region
# (eu. for Europe, us. for US, au. for Australia, ...).
# MODEL_ID=eu.amazon.nova-pro-v1:0

# Optional: override the model IDs offered in server.py / demo.py (for example au.anthropic.claude-sonnet-4-6 in Sydney).
# MODEL_NOVA=eu.amazon.nova-pro-v1:0
# MODEL_SONNET=eu.anthropic.claude-sonnet-4-6

# Optional: give the starter agent external tools from an MCP server, such as an AgentCore Gateway.
# MCP_SERVER_URL=
# MCP_BEARER_TOKEN=

# Let the Python tool run without asking for a y/n in the terminal.
# server.py sets this itself; it is needed here only for demo.py.
BYPASS_TOOL_CONSENT=true

# Workshop sandbox settings: the sandbox role only allows the US inference profiles, so these
# override the eu-central-1 defaults above. In your own account, change them to your region and
# matching profile prefix (eu., us., au., ...), or comment these lines out to use the defaults.
AGENTCORE_REGION=us-east-1
MODEL_ID=us.amazon.nova-pro-v1:0
MODEL_NOVA=us.amazon.nova-pro-v1:0
MODEL_SONNET=us.anthropic.claude-sonnet-4-6
